# ==========================================
# CẤU HÌNH DISCORD BOT MANY CURIEL
# ==========================================

# Token xác thực bot từ Discord Developer Portal (tab Bot -> Reset Token)
DISCORD_TOKEN=YOUR_BOT_TOKEN

# Application ID của bot (tab General Information -> Application ID)
CLIENT_ID=YOUR_BOT_CLIENT_ID

# ID Server Discord dùng để deploy setup slash command test (tùy chọn)
GUILD_ID=YOUR_TEST_SERVER_ID

# ID Chủ sở hữu tối cao (Owner) - Bắt buộc: 1402913586853974156
OWNER_ID=1402913586853974156

# Môi trường chạy bot (development hoặc production)
NODE_ENV=production
